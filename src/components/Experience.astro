---
import ExperienceItem from "./ExperienceItem.astro";
import { getI18N } from "@/i18n/utils";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const EXPERIENCE = [
  {
    date: i18n.EXPERIENCE_DEDOMENAAI_DATE,
    title: i18n.EXPERIENCE_DEDOMENAAI_TITLE,
    company: "DedomenaAI",
    points: i18n.EXPERIENCE_DEDOMENAAI_POINTS,
  },
  {
    date: i18n.EXPERIENCE_SKINSAGEPROAI_DATE,
    title: i18n.EXPERIENCE_SKINSAGEPROAI_TITLE,
    company: "SkinSageProAI",
    points: i18n.EXPERIENCE_SKINSAGEPROAI_POINTS,
  },
  {
    date: i18n.EXPERIENCE_DIXBASE_DATE,
    title: i18n.EXPERIENCE_DIXBASE_TITLE,
    company: "DixBase",
    points: i18n.EXPERIENCE_DIXBASE_POINTS,
  },
  {
    date: i18n.EXPERIENCE_Z17_DATE,
    title: i18n.EXPERIENCE_Z17_TITLE,
    company: i18n.EXPERIENCE_Z17_COMPANY,
    points: i18n.EXPERIENCE_Z17_POINTS,
  },
];
---

<div class="relative mt-12">
  <ol class="relative space-y-8">
    {
      EXPERIENCE.map((experience, index) => (
        <li class="experience-item" style={`animation-delay: ${index * 150}ms`}>
          <ExperienceItem {...experience} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .experience-item {
    opacity: 0;
    animation: slide-in 0.6s ease-out forwards;
  }

  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
